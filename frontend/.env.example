# ── API mode ──────────────────────────────────────────────────────────────────
# The only value you need to change to switch environments.
# 'web'   → hosted Azure SLOMS API (production default, no .env needed)
# 'local' → local Docker stack on http://localhost:3000
#            Start first: cd sloms_local_dev && docker compose -f docker-compose.local.yml up
EXPO_PUBLIC_API_MODE=web

# Optional: override the resolved API URL entirely (rarely needed).
# EXPO_PUBLIC_API_URL=

# ── Debug flags (dev-only) ────────────────────────────────────────────────────
# Enables targeted console logging per workflow. Only active in __DEV__ builds;
# stripped from production via dead-code elimination. Values are strings: "true"/"false".
# EXPO_PUBLIC_DEBUG_CUSTOMERS=false
# EXPO_PUBLIC_DEBUG_ORDERS=false
# EXPO_PUBLIC_DEBUG_AUTH=false
