{
  "name": "sonic_app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "preandroid": "bash scripts/connect-waydroid.sh 2>/dev/null || true",
    "android": "expo start --android",
    "waydroid": "bash scripts/connect-waydroid.sh && expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env NODE_PATH=node_modules playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "cross-env NODE_PATH=node_modules playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:report": "cross-env NODE_PATH=node_modules playwright show-report"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "lucide-react-native": "^1.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.60.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/parser": "^8.58.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "otplib": "^13.4.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
