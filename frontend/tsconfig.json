{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@theme/*": ["./src/theme/*"],
      "@context/*": ["./src/context/*"],
      "@components/*": ["./src/components/*"],
      "@utils/*": ["./utils/*"],
      "@assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
